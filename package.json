{
  "name": "auth-microservice",
  "version": "1.0.0",
  "description": "Centralized authentication service for user registration, login, and JWT token management",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:auth-contract": "jest --runInBand --runTestsByPath src/auth/auth-contract.spec.ts src/auth/auth-contact-code.spec.ts src/auth/hosted-auth-web.spec.ts",
    "check:customer-data-wallet-preflight": "node scripts/check-customer-data-wallet-preflight.js",
    "check:customer-data-wallet-runtime": "node scripts/check-customer-data-wallet-runtime-smoke.js",
    "check:customer-data-wallet-authenticated": "node scripts/check-customer-data-wallet-authenticated-smoke.js",
    "check:customer-data-wallet-runtime-gate-packet": "node scripts/check-customer-data-wallet-runtime-gate-packet.js",
    "check:ecosystem-auth-rollout-docs": "bash scripts/check-ecosystem-hosted-auth-rollout-docs.sh",
    "check:aos-auth-readiness": "bash scripts/check-aos-auth-modernization-readiness.sh",
    "check:customer-data-wallet-completion-gap": "node scripts/check-customer-data-wallet-completion-gap.js",
    "check:customer-data-wallet-hosted-profile-static": "node scripts/check-customer-data-wallet-hosted-profile-static.js",
    "verify:orders-action-admin-rbac-seed": "node scripts/verify-orders-action-admin-rbac-seed.js",
    "check:auth-email-change-runtime": "node scripts/check-auth-email-change-runtime-smoke.js",
    "check:auth-email-change-activation-source": "node scripts/check-auth-email-change-activation-source.js",
    "check:profile-centralization-current-state": "node scripts/check-profile-centralization-current-state.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
