apiVersion: v1
kind: Secret
metadata:
  name: auth-microservice-secret
  namespace: statex-apps
  labels:
    app: auth-microservice
    managed-by: k8s-migration
type: Opaque
stringData:
  # All values must come from project .env (single source of truth). Do not commit k8s/secret.yaml.
  DB_PASSWORD: ""
  JWT_SECRET: ""
  TEST_EMAIL: ""
  TEST_PASSWORD: ""
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  FACEBOOK_CLIENT_ID: ""
  FACEBOOK_CLIENT_SECRET: ""
