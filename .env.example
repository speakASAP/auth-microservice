# =============================================================================
# Auth Unified Environment Configuration. Single Source of Truth
# =============================================================================
# Service Domain - Used by nginx-microservice for auto-registry (required for correct domain detection)
# Service Name - Used for logging and service identification
NODE_ENV=
DOMAIN=
SERVICE_NAME=

# Service Configuration
PORT=
CORS_ORIGIN=

# Frontend URL - For password reset links
FRONTEND_URL=

# Database (Shared)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SYNC=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Logging (Shared)
LOG_LEVEL=
LOGGING_SERVICE_URL=

# Notifications (Shared) - For password reset emails
NOTIFICATIONS_SERVICE_URL=

# Logs Volume Path - Path for storing logs (default: ./logs)
LOGS_VOLUME_PATH=
