# =============================================================================
# Auth Unified Environment Configuration. Single Source of Truth
# =============================================================================
# Service Domain - Used by nginx-microservice for auto-registry (required for correct domain detection)
# Service Name - Used for logging and service identification
NODE_ENV=
DOMAIN=
SERVICE_NAME=

# Service Configuration
# Web interface (frontend container). Auth uses 3372 (blue) / 3373 (green) per README; 3374/3375 = agentic-email-processing-system.
# Like notifications-microservice: single PORT for backend; auth adds frontend so needs FRONTEND_PORT_*.
FRONTEND_PORT=3372
FRONTEND_PORT_BLUE=3372
FRONTEND_PORT_GREEN=3373

# Backend host ports (blue/green use different host ports to avoid conflicts)
# Must be 3370 for blue/green health checks (green host mapping 3371:3370). Do not set to 3371.
PORT=3370
BACKEND_PORT_BLUE=3370
BACKEND_PORT_GREEN=3371

# Backend container names (must match nginx-microservice naming: {container_name_base}-{color})
BACKEND_CONTAINER_NAME_BLUE=auth-microservice-blue
BACKEND_CONTAINER_NAME_GREEN=auth-microservice-green

# Comma-separated origins for CORS (required for admin logins from other services).
# Supports explicit origins and wildcard domains:
# - Explicit: https://auth.alfares.cz,https://logging.alfares.cz
# - Wildcards: *.alfares.cz,*.alfares.cz (any subdomain of these)
# Leave empty for development (allows * without credentials).
CORS_ORIGIN=

# Frontend URL - For password reset links
FRONTEND_URL=

# Database (Shared)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SYNC=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Logging (Shared)
LOG_LEVEL=
LOGGING_SERVICE_URL=

# Notifications (Shared) - For password reset emails (same key as docker-compose; not NOTIFICATIONS_SERVICE_URL)
NOTIFICATION_SERVICE_URL=

# Kubernetes: deploy.sh renders k8s/configmap.yaml.template with envsubst (all keys above + optional K8S_* below) and applies the Secret from .env (see k8s/secret.yaml.example).
# Optional: K8s namespace (default statex-apps) and in-cluster URLs for the ConfigMap (defaults match cluster DNS; set if your cluster differs).
K8S_NAMESPACE=
K8S_LOGGING_SERVICE_URL=
K8S_NOTIFICATION_SERVICE_URL=

# Database Auto-Creation (optional; default true)
DB_AUTO_CREATE=

# Logs Volume Path - Path for storing logs (default: ./logs)
LOGS_VOLUME_PATH=

# Test user (for scripts/create-test-user.sh and admin panel login). Store password only in .env.
# TEST_EMAIL=test@example.com
# TEST_PASSWORD=<set-in-env-only-not-in-docs>

# Auth URL for create-test-user.sh: use on prod so script reaches API via nginx (e.g. https://auth.alfares.cz)
# AUTH_URL=https://auth.alfares.cz

# Redirect allowlist and magic link / OAuth configuration (keys only)
# Production must keep AUTH_ALLOWED_REDIRECT_ORIGINS populated. Empty is local-dev compatibility only.
AUTH_ALLOWED_REDIRECT_ORIGINS=
AUTH_MAGIC_LINK_TTL_MINUTES=
# Lifetime of every password-recovery artefact: the emailed code, the grant it buys, and the
# grant issued by the reset link. Shown to the user in all four places it applies. Default 15.
AUTH_PASSWORD_RECOVERY_TTL_MINUTES=
AUTH_MAGIC_LINK_RATE_LIMIT_PER_IP=
AUTH_MAGIC_LINK_RATE_LIMIT_PER_EMAIL=
AUTH_OAUTH_INIT_RATE_LIMIT_PER_IP=
AUTH_RATE_LIMIT_WINDOW_MS=
# Contact-code delivery. Phone defaults to WhatsApp because notifications-microservice does not dispatch SMS directly yet.
AUTH_CONTACT_CODE_PHONE_CHANNEL=whatsapp
AUTH_CONTACT_CODE_PHONE_CHANNEL_KEY=
AUTH_CONTACT_CODE_EMAIL_CHANNEL_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_AUTH_URL=
GOOGLE_OAUTH_TOKEN_URL=
GOOGLE_OAUTH_PROFILE_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_OAUTH_AUTH_URL=
FACEBOOK_OAUTH_TOKEN_URL=
FACEBOOK_OAUTH_PROFILE_URL=

AUTH_URL=
TEST_EMAIL=
TEST_PASSWORD=

JWT_TOKEN=

# Internal service-to-service auth for /internal/* endpoints (Vault: secret/prod/auth-microservice)
INTERNAL_SERVICE_TOKEN=
# Optional comma-separated allowlist of x-service-name values (empty = any service with valid token)
TRUSTED_INTERNAL_SERVICES=

# HMAC secret for marketing unsubscribe links (Vault: secret/prod/auth-microservice)
# Must match MARKETING_UNSUBSCRIBE_SECRET in marketing-microservice or every
# unsubscribe link in every sent message fails verification.
MARKETING_UNSUBSCRIBE_SECRET=
